# App & Infra
PROJECT_NAME=nguyenquangtrungminicloud
DOCKER_DEFAULT_NETWORK=cloud-net

# Web
WEB_PORT=8080

# Backend
APP_PUBLIC_PORT=8085
APP_INTERNAL_PORT=8081

# DB
DB_PORT=3306
DB_ROOT_PASSWORD=rootpass
DB_NAME=minicloud
DB_USER=mini
DB_PASSWORD=minipass

# Keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_USER=admin
KEYCLOAK_PASSWORD=admin

# MinIO
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# DNS
DNS_PORT_UDP=5353
DNS_PORT_TCP=5353

# Monitoring
PROMETHEUS_PORT=9090
NODE_EXPORTER_PORT=9100
GRAFANA_PORT=3000

# Reverse Proxy
PROXY_PORT=80
